[Unit]
Description=linux-cmd-mcp (SSE MCP server for Linux commands)
Documentation=https://github.com/Balckers/linux-cmd-mcp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=linuxcmd
Group=linuxcmd
EnvironmentFile=/etc/linux-cmd-mcp.env
ExecStart=/usr/local/bin/linux-cmd-mcp --transport sse --host 0.0.0.0 --port 8765
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
